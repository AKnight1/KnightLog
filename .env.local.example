# Copy this file to .env.local and fill in values from your Supabase
# project dashboard (Project Settings → API). .env.local is gitignored.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never exposed to the browser. Used solely by the signup
# flow to create accounts before the user has a session. Get it from
# Project Settings → API Keys → Secret keys (the "eye" icon reveals it).
SUPABASE_SERVICE_ROLE_KEY=
